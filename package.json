{
  "name": "mirsal-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Mirsal - multi-tenant FiveM AI control platform (Firebase + Vercel + Gemini)",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "check": "node scripts/check-build.js",
    "dev": "node scripts/dev-server.js",
    "test": "firebase emulators:exec --only auth,firestore --project demo-mirsal \"node --test tests/*.test.js\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-mirsal",
    "seed": "node scripts/seed.js",
    "seed:emulator": "firebase emulators:exec --only firestore --project demo-mirsal \"node scripts/seed.js --verify\"",
    "activate": "node scripts/activate.js",
    "smoke:emulator": "firebase emulators:exec --only auth,firestore --project demo-mirsal \"node scripts/smoke-emulator.js\""
  },
  "dependencies": {
    "@google/genai": "^1.16.0",
    "adm-zip": "^0.5.18",
    "dotenv": "^16.4.5",
    "firebase-admin": "^13.0.0"
  },
  "devDependencies": {
    "firebase-tools": "^14.0.0",
    "jsdom": "^25.0.1"
  }
}
