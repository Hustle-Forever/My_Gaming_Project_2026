# Copy this file to .env and fill in real values. NEVER commit .env.
PORT=8787

# Shared secret the app sends in the x-app-secret header
APP_SECRET=change-me-app-secret

# Per-tenant secrets. The env var NAMES are referenced from config/tenants.json
# (the "seam" that later moves to a DB row per customer).
DEMO_BRIDGE_TOKEN=change-me-bridge-token
DEMO_ANTHROPIC_API_KEY=sk-ant-...    # the tenant's own key (BYOK). Leave unset to run in stub-interpret mode.
