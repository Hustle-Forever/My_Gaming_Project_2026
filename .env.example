# Copy to .env for local development. NEVER commit .env.
# On Vercel these are set as project environment variables (section: README).

# --- required in production ---
# The Firebase service-account JSON, as one line (Project settings -> Service accounts).
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=your-firebase-project-id
# 32 random bytes as 64 hex chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- optional ---
PROVIDER=gemini
GEMINI_MODEL=gemini-3.6-flash
# Port for the local dev server (scripts/dev-server.js)
PORT=3000
# Per-tenant /api/command limit (fixed window, per minute). Default 30.
RATE_LIMIT_PER_MIN=30
# Per-IP /api/signup limit (fixed window, per hour; IPs stored hashed). Default 20.
SIGNUP_RATE_LIMIT_PER_HOUR=20
# CORS stays same-origin unless this is set to the app's origin (or "*").
# Only needed if the frontend is hosted on a different domain than the API.
ALLOWED_ORIGIN=
